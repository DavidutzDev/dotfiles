{
    "layer": "top", 
    "position": "top", 
    "modules-left": ["custom/main", "custom/music"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["pulseaudio", "clock", "tray", "custom/lock"],
    "hyprland/workspaces": {
         "disable-scroll": true,
         "sort-by-name": true,
         "format": "{icon}",
         "format-icons": {
            "1": "󰈹",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "0": "",
            "default": ""
         },
        "persistent-workspaces": {
            "*": 5,
        },
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "custom/main": {
        "format": "󰣇",
        "on-click": "walker"
    },
    "custom/music": {
        "format": "  {}",
        "escape": true,
        "interval": 5,
        "tooltip": false,
        "exec": "playerctl metadata --format='{{ title }}'",
        "on-click": "playerctl play-pause",
        "max-length": 50
    },
    "clock": {
        "timezone": "Europe/Paris",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": " {:%d/%m/%Y}",
        "format": " {:%H:%M}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },
    "custom/lock": {
        "tooltip": false,
        "on-click": "walker -m menus:powermenu",
        "format": "󰐥"
    }
}
